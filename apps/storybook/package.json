{
  "name": "@bestow-ui/storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "node ../../scripts/generate-llms.mjs && storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "test:stories": "vitest run",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@bestow-ui/icons": "workspace:*",
    "@bestow-ui/react": "workspace:*",
    "@bestow-ui/tokens": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "1.64.1",
    "storybook": "^10.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
