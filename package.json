{
  "name": "bestow-ui",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @bestow-ui/storybook dev",
    "storybook": "pnpm --filter @bestow-ui/storybook dev",
    "build-storybook": "pnpm --filter @bestow-ui/storybook build",
    "playground": "pnpm --filter @bestow-ui/playground dev",
    "build-playground": "pnpm --filter @bestow-ui/playground build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "~5.9.3"
  }
}
