{
  "name": "bestow-ui",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @bestow-ui/storybook dev",
    "storybook": "pnpm --filter @bestow-ui/storybook dev",
    "build-storybook": "pnpm --filter @bestow-ui/storybook build",
    "playground": "pnpm --filter @bestow-ui/playground dev",
    "build-playground": "pnpm --filter @bestow-ui/playground build",
    "size": "size-limit",
    "test": "pnpm -r test",
    "test:stories": "pnpm --filter @bestow-ui/storybook test:stories",
    "test:visual": "pnpm --filter @bestow-ui/storybook test:visual",
    "test:e2e": "pnpm --filter @bestow-ui/playground test:e2e",
    "test:visual:update": "pnpm --filter @bestow-ui/storybook test:visual:update",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-small-lib": "^14.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
