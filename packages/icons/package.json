{
  "name": "@bestow-ui/icons",
  "version": "0.1.1",
  "description": "SVG icons as tree-shakable React components for BestOW UI (based on Lucide)",
  "keywords": [
    "bestow-ui",
    "design-system",
    "react",
    "icons",
    "svg",
    "react-icons",
    "lucide"
  ],
  "license": "ISC",
  "author": "Dev-BestOW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-BestOW/BestOW-UI.git",
    "directory": "packages/icons"
  },
  "homepage": "https://dev-bestow.github.io/BestOW-UI/",
  "bugs": {
    "url": "https://github.com/Dev-BestOW/BestOW-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
