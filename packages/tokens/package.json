{
  "name": "@bestow-ui/tokens",
  "version": "0.8.1",
  "description": "Design tokens for BestOW UI — colors, spacing, radius, typography, shadow, motion",
  "keywords": [
    "bestow-ui",
    "design-system",
    "design-tokens",
    "tokens",
    "colors",
    "theme"
  ],
  "license": "MIT",
  "author": "Dev-BestOW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-BestOW/BestOW-UI.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://dev-bestow.github.io/BestOW-UI/",
  "bugs": {
    "url": "https://github.com/Dev-BestOW/BestOW-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
