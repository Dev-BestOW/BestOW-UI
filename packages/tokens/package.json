{
  "name": "@bestow-ui/tokens",
  "version": "1.3.0",
  "description": "BestOW UI 디자인 토큰 — 색상·간격·모서리·글자·그림자·시간·쌓임 순서 (의존성 없음, 프레임워크 무관)",
  "keywords": [
    "design-tokens",
    "tokens",
    "design-system",
    "colors",
    "theme",
    "dark-mode",
    "korean",
    "bestow-ui",
    "디자인시스템"
  ],
  "license": "MIT",
  "author": "Dev-BestOW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-BestOW/BestOW-UI.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://dev-bestow.github.io/BestOW-UI/",
  "bugs": {
    "url": "https://github.com/Dev-BestOW/BestOW-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
