{
  "name": "@bestow/react",
  "version": "0.0.0",
  "description": "BestOW UI React components",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@bestow/tokens": "workspace:^",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
