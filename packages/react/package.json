{
  "name": "@bestow-ui/react",
  "version": "0.11.0",
  "description": "React components and theming for BestOW UI — vanilla-extract + Radix, light/dark and brand themes, accessible by default",
  "keywords": [
    "bestow-ui",
    "design-system",
    "react",
    "components",
    "ui",
    "vanilla-extract",
    "radix-ui",
    "dark-mode",
    "theming",
    "accessibility",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Dev-BestOW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-BestOW/BestOW-UI.git",
    "directory": "packages/react"
  },
  "homepage": "https://dev-bestow.github.io/BestOW-UI/",
  "bugs": {
    "url": "https://github.com/Dev-BestOW/BestOW-UI/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@bestow-ui/icons": "workspace:^",
    "@bestow-ui/tokens": "workspace:^",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
